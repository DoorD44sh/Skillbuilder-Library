* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    min-height: 100vh;
    background: #101114;
    color: #f5f5f5;
    font-family: Arial, sans-serif;
}

button {
    font: inherit;
    border: 0;
    cursor: pointer;
}

.sidebar {
    position: fixed;
    left: 0;
    top: 0;
    width: 240px;
    height: 100vh;
    padding: 24px 16px;
    background: #181a1f;
    border-right: 1px solid #292c33;
    display: flex;
    flex-direction: column;
    transition: width 0.25s ease;
    z-index: 10;
}

.logo {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 32px;
}

.logo span {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border-radius: 10px;
    background: #6c63ff;
    font-weight: bold;
}

.logo strong {
    font-size: 16px;
}

.sidebar nav {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.nav-item {
    width: 100%;
    padding: 11px 12px;
    border-radius: 9px;
    background: transparent;
    color: #aeb2bd;
    text-align: left;
}

.nav-item:hover,
.nav-item.active {
    background: #242730;
    color: white;
}

.collapse-btn {
    margin-top: auto;
    padding: 10px;
    border-radius: 9px;
    background: #242730;
    color: #aeb2bd;
}

.main-content {
    margin-left: 240px;
    min-height: 100vh;
    transition: margin-left 0.25s ease;
}

.topbar {
    height: 72px;
    padding: 0 28px;
    display: flex;
    align-items: center;
    border-bottom: 1px solid #292c33;
}

.top-buttons {
    display: flex;
    gap: 8px;
}

.mode-button {
    padding: 9px 16px;
    border-radius: 9px;
    background: #1b1d23;
    color: #aeb2bd;
}

.mode-button.active {
    background: #6c63ff;
    color: white;
}

#pageContent {
    padding: 40px;
}

#pageContent h1 {
    font-size: 32px;
    margin-bottom: 8px;
}

#pageContent p {
    color: #969ba8;
}

.mobile-menu,
.mobile-nav {
    display: none;
}

.sidebar.collapsed {
    width: 72px;
}

.sidebar.collapsed .logo strong,
.sidebar.collapsed .nav-item,
.sidebar.collapsed .collapse-btn {
    font-size: 0;
}

.sidebar.collapsed .logo {
    justify-content: center;
}

.sidebar.collapsed .nav-item {
    height: 42px;
}

.main-content:has(+ .sidebar.collapsed) {
    margin-left: 72px;
}

@media (max-width: 700px) {
    .sidebar {
        display: none;
    }

    .main-content {
        margin-left: 0;
        padding-bottom: 72px;
    }

    .topbar {
        height: 62px;
        padding: 0 16px;
    }

    .mobile-menu {
        display: block;
        margin-right: 12px;
        background: transparent;
        color: white;
        font-size: 22px;
    }

    .top-buttons {
        flex: 1;
    }

    .mode-button {
        flex: 1;
        padding: 8px 10px;
    }

    #pageContent {
        padding: 24px 16px;
    }

    #pageContent h1 {
        font-size: 25px;
    }

    .mobile-nav {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        height: 64px;
        background: #181a1f;
        border-top: 1px solid #292c33;
        display: flex;
        justify-content: space-around;
        align-items: center;
        z-index: 20;
    }

    .mobile-nav button {
        background: transparent;
        color: #969ba8;
        font-size: 11px;
    }

    .mobile-nav button:hover {
        color: white;
    }
}
